# Copy to .env.local and adjust. NEXT_PUBLIC_* vars are inlined at build time.

# Base URL of the FastAPI backend (acpsec_api). Local dev default:
NEXT_PUBLIC_API_URL=http://localhost:8001

# Scanner/onchain auth. Set ONLY if the backend has SCANNER_TOKEN configured;
# it is attached as X-Scanner-Token to /api/scanner/* and /api/onchain/* only.
# NEXT_PUBLIC_SCANNER_TOKEN=
